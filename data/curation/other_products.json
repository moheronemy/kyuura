 "differences": {
  "1stmv016": [
   {
    "kind": "text",
    "summary": "ワザ どくばり（Poison Sting）の特殊状態",
    "ja": "「コインを投げて『おもて』なら、相手を『どく』状態にする。」",
    "en": "「Flip a coin. If heads, the Defending Pokémon is now Paralyzed.」と、マヒになっている。英語版での変更とされる",
    "confidence": "確実",
    "sources": [
     "N1",
     "N3",
     "X42"
    ]
   }
  ],
  "1stmv004": [
   {
    "kind": "text",
    "summary": "ワザ レインボーウェーブ（Rainbow Wave）で選べるタイプ",
    "ja": "「自分についている『基本エネルギーカード』の色(タイプ)から、1つを選ぶ」と、基本エネルギーに限っている",
    "en": "「Choose a type of Energy other than Colorless attached to Mew」と、特殊エネルギー（レインボーエネルギー、neo の悪・鋼エネルギーなど）のタイプも選べる",
    "confidence": "有力",
    "sources": [
     "N1",
     "N3"
    ]
   }
  ],
  "1stex2012": [
   {
    "kind": "text",
    "summary": "ポケモンパワー オーロラヴェール（Aurora Veil）が働かなくなる状態",
    "ja": "「このカードが『ねむり・マヒ・こんらん』状態の時、この力は消える」",
    "en": "「This power cannot be used if Articuno is affected by a Special Condition.」と、どく・やけども含む特殊状態すべて",
    "confidence": "確実",
    "sources": [
     "N3",
     "X41"
    ]
   }
  ],
  "1stex1034": [
   {
    "kind": "text",
    "summary": "ポケモンパワー とおせんぼ（Guard）が働かなくなる状態",
    "ja": "「このカードが『ねむり・マヒ・こんらん』状態の時、この力は消える」（pcg-search の転記は「このカは消える」）",
    "en": "「This power stops working when Snorlax is affected by a Special Condition.」と、どく・やけども含む特殊状態すべて",
    "confidence": "有力",
    "sources": [
     "N3"
    ]
   }
  ]
 },
